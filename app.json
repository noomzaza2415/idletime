{
  "expo": {
    "name": "idletime",
    "slug": "idletime",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "idletime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.noomzaza.idletime",
      "buildNumber": "2",
      "supportsTablet": false,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "ให้ Idle Time Tracker เชื่อมต่อระบบในเครือข่ายโรงงาน เพื่อดูและบันทึกรายการไลน์หยุด"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.noomzaza.idletime",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withGradleDaemonJvm",
      "./plugins/withReleaseSigning",
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 190
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ให้ Idle Time Tracker เข้าถึงคลังภาพ เพื่อแนบรูปจุดที่ไลน์หยุด",
          "cameraPermission": "ให้ Idle Time Tracker ใช้กล้อง เพื่อถ่ายรูปจุดที่ไลน์หยุด",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca9a8fb3-fbc4-4397-bb74-98df29e86c0f"
      },
      "firebase": {
        "apiKey": "AIzaSyCASgfXIOOs4PuRx_H-KPs76ylScv__aMY",
        "projectId": "idletime-3681e"
      }
    },
    "owner": "noomzaza",
    "updates": {
      "url": "https://u.expo.dev/ca9a8fb3-fbc4-4397-bb74-98df29e86c0f"
    }
  }
}
