# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ server จริง
#   cp .env.example .env

# พอร์ตที่บริการเปิดรอ ต้องเปิด firewall และทำ port forward ให้มือถือนอกวงเข้าถึงได้
PORT=8090

# ไฟล์ service account key ที่ดาวน์โหลดจาก Firebase Console
# Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# ที่เก็บรายการ token ของเครื่องที่ลงทะเบียน
# ถ้ารันด้วย Docker ให้ mount โฟลเดอร์นี้ออกมา ไม่งั้นข้อมูลหายทุกครั้งที่ลบ container
DATA_FILE=./data/tokens.json

# กุญแจสำหรับเรียก /Notify — ต้องตั้ง ไม่งั้นบริการจะไม่ยอมเริ่ม
# สุ่มด้วย: openssl rand -hex 32
NOTIFY_API_KEY=เปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง

# API ของ Idle Time ที่บริการจะไปถามหารายการใหม่เอง
IDLE_API_URL=http://192.168.2.5:5053
IDLE_RECORDS_PATH=/api/v1/IdleTime/GetLineIdleTimeDtoAsync

# ความถี่ในการถามหารายการใหม่ (มิลลิวินาที)
# ตั้ง 0 เพื่อปิด แล้วให้ระบบอื่นเรียก /Notify เองแทน
WATCH_INTERVAL_MS=60000

# อ่าน token จาก Firestore ด้วย (นอกจากไฟล์ในเครื่อง)
# ทำให้มือถือนอกวง LAN ลงทะเบียนเองได้ ตั้ง false ถ้ายังไม่ได้สร้าง Firestore database
USE_FIRESTORE=true

# ---------------------------------------------------------------
# ใช้เฉพาะตอนเก็บรูปไว้บนเครื่องอื่นผ่านโฟลเดอร์แชร์
# (docker-compose.deploy-share.yml เท่านั้น ไฟล์ deploy ปกติไม่ต้องตั้ง)
# ---------------------------------------------------------------

# บัญชีบนเครื่องที่แชร์โฟลเดอร์ ต้องมีสิทธิ์เขียนในโฟลเดอร์นั้น
SHARE_USER=svc_idletime
SHARE_PASSWORD=รหัสผ่านของบัญชีข้างบน

# ที่เก็บรูปในมุมมองของ container ตรงกับ volume ที่ mount ไว้
PHOTO_DIR=/app/photos
